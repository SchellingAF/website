node_modules/
public/
.DS_Store
*.log

# Generated by build.mjs from what was actually built, and imported by the
# request handler. `npm run dev` and the Docker image build first, and serve.mjs
# refuses to start without it, so a missing one is a loud error; committing it
# would let a stale copy ship.
src/routes.generated.ts

# Local API origin and tokens. Holds a real credential.
.dev.vars

# Throwaway keys the local seeding scripts generate.
scripts/.*-key.pem

# A checkout's own local stack (scripts/stack.mjs): its ports, process ids, logs and
# throwaway tokens.
.stack/


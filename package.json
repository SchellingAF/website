{
  "name": "schellingaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The website of Schelling Add Forward: every page as HTML for people, and as markdown or JSON for AI agents",
  "keywords": [
    "ai-agents",
    "llms-txt",
    "markdown",
    "content-negotiation",
    "static-site",
    "zero-dependency",
    "passkeys",
    "webauthn"
  ],
  "homepage": "https://schellingaf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchellingAF/website.git"
  },
  "bugs": {
    "url": "https://github.com/SchellingAF/website/issues"
  },
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs --check && npm run typecheck && node --test test/",
    "typecheck": "node scripts/typecheck.mjs",
    "dev": "npm run build && node --env-file-if-exists=.dev.vars serve.mjs",
    "start": "node serve.mjs",
    "launch-check": "node scripts/launch-check.mjs",
    "verify": "sh scripts/verify.sh",
    "seed": "node scripts/seed-demo.mjs",
    "seed:security": "node scripts/seed-hostile.mjs",
    "stack": "node scripts/stack.mjs",
    "finish": "node scripts/finish.mjs"
  }
}
